{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wowchar.py\" update --quiet --hook 2>&1 || true",
            "timeout": 45,
            "statusMessage": "Updating WoW character snapshots..."
          }
        ]
      }
    ]
  }
}
